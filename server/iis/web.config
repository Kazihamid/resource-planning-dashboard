<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS front end for the shared-plan server.
  Put this file (alone) in the IIS site's physical folder. IIS signs users in with
  Windows Authentication and forwards every request to the Node server on 127.0.0.1:3000,
  passing the signed-in user in the X-Remote-User header.
  Requires: URL Rewrite + Application Request Routing (proxy enabled), and
  HTTP_X_REMOTE_USER added to the allowed server variables. See README "Option D".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ResourceDashboardToNode" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Overwrites any X-Remote-User header sent by the browser. -->
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
